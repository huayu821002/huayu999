# Database - Supabase PostgreSQL (required for production)
# Get from Supabase Dashboard > Settings > Database > Connection string
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Authentication
JWT_SECRET="CHANGE_ME_generate_a_random_64char_secret"
JWT_EXPIRES_IN="7d"

# Application
NEXT_PUBLIC_APP_URL="https://fiestaflare.com"
NEXT_PUBLIC_APP_NAME="Fiestaflare"

# Optional: Stripe Payment
# STRIPE_SECRET_KEY="sk_test_xxxxx"
# STRIPE_PUBLISHABLE_KEY="pk_test_xxxxx"

# Email Service — Choose one provider:
# Brevo (recommended): https://app.brevo.com/settings/keys
BREVO_API_KEY=""
# SendGrid: https://app.sendgrid.com/settings/api_keys
# SENDGRID_API_KEY=""
# Resend: https://resend.com
# RESEND_API_KEY=""
