# Database
DATABASE_URL="postgresql://user:password@localhost:5432/joyhub_wholesale"

# Authentication
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Stripe (Payment Processing)
STRIPE_SECRET_KEY="sk_test_xxxxx"
STRIPE_PUBLISHABLE_KEY="pk_test_xxxxx"
STRIPE_WEBHOOK_SECRET="whsec_xxxxx"

# WhatsApp Business API (for inquiry floating button)
WHATSAPP_BUSINESS_NUMBER="12025551234"

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="JoyHub Wholesale"

# Email (for notifications)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
EMAIL_FROM="JoyHub <noreply@joyhubwholesale.com>"

# File Storage (S3 or compatible)
S3_BUCKET="joyhub-uploads"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="xxxxx"
S3_SECRET_ACCESS_KEY="xxxxx"

# Currency Exchange API (optional - for live rates)
EXCHANGE_RATE_API_KEY="xxxxx"
